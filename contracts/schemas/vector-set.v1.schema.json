{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noeos:verification-engine:vector-set:1",
  "title": "Noeos Verification Engine Vector Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "protocolVersion", "license", "files", "sources"],
  "properties": {
    "$schema": { "const": "urn:noeos:verification-engine:vector-set:1" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "protocolVersion": { "const": 1 },
    "license": { "const": "Apache-2.0" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "category", "caseCount", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9./-]*\\.json$",
            "maxLength": 256
          },
          "category": { "enum": ["hashing", "framing", "evidence", "invalid"] },
          "caseCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "license"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
          "url": { "type": "string", "pattern": "^https://[^\\s]{1,2040}$", "maxLength": 2048 },
          "license": { "type": "string", "maxLength": 128 },
          "revision": { "type": "string", "maxLength": 128 }
        }
      }
    }
  }
}
