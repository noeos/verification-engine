{
  "actions": {
    "allowedActions": "selected",
    "allowedReferences": {
      "githubOwned": true,
      "patterns": [
        "google/osv-scanner-action/osv-scanner-action@90b209d0ea55cea1da9fc0c4e65782cc6acb6e2e",
        "ossf/scorecard-action@4eaacf0543bb3f2c246792bd56e8cdeffafb205a"
      ],
      "verified": false
    },
    "defaultWorkflowPermissions": "read",
    "forkPullRequestApprovalRequired": true,
    "workflowsCanApprovePullRequests": false
  },
  "branchRules": {
    "main": {
      "allowDeletions": false,
      "allowForcePushes": false,
      "bypassActors": [],
      "dismissStaleReviews": true,
      "enforceAdmins": true,
      "requireConversationResolution": true,
      "requireLastPushApproval": false,
      "requireLinearHistory": true,
      "requirePullRequest": true,
      "requireSignedCommits": true,
      "requiredApprovingReviewCount": 0,
      "requiredChecks": [
        "Required · quality and policy",
        "Required · ubuntu-24.04 · Node 22.14.0",
        "Required · ubuntu-24.04 · Node 22.23.2",
        "Required · ubuntu-24.04 · Node 24.19.0",
        "Required · windows-2025 · Node 24.19.0",
        "Required · macos-15 · Node 24.19.0",
        "Required · package reproducibility",
        "Required · dependency review",
        "Required · CodeQL",
        "Required · secret scan",
        "Required · OSV",
        "Required · npm audit and license inventory"
      ]
    }
  },
  "defaultBranch": "main",
  "deleteBranchOnMerge": true,
  "environments": {
    "npm-staging": {
      "deploymentTagPattern": "v*.*.*-rc.*",
      "preventSelfReview": false,
      "requiredReviewers": ["@ddavid07"],
      "selectedTagsOnly": true
    }
  },
  "features": {
    "automatedSecurityFixes": true,
    "dependabotAlerts": true,
    "issues": true,
    "privateVulnerabilityReporting": true,
    "secretScanning": true,
    "secretScanningPushProtection": true
  },
  "merge": {
    "allowMergeCommit": false,
    "allowRebaseMerge": false,
    "allowSquashMerge": true
  },
  "repository": "noeos/verification-engine",
  "tagRules": {
    "v*": {
      "allowDeletions": false,
      "allowUpdates": false,
      "bypassActors": [],
      "requireSignedTags": true
    }
  },
  "topics": ["data-integrity", "nodejs", "typescript", "verification"],
  "visibility": "public",
  "webCommitSignoffRequired": true
}
