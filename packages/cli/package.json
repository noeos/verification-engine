{
  "name": "@noeos/verification-engine-cli",
  "version": "1.0.0",
  "private": false,
  "description": "Command-line interface for the Noeos verification engine.",
  "license": "Apache-2.0",
  "author": "Noeos contributors",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0 <23 || >=24.0.0 <25"
