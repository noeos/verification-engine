{
  "name": "@noeos/verification-engine-cli",
  "version": "1.0.1",
  "private": false,
  "description": "Deterministic CLI for hashing, verifying, and streaming integrity evidence with JSON and NDJSON output.",
  "keywords": [
    "verification",
    "data-integrity",
    "hash-chain",
    "cryptography",
    "audit-trail",
    "evidence",
    "offline-first",
    "ndjson",
    "cli",
    "nodejs"
  ],
  "license": "Apache-2.0",
  "author": "Noeos contributors",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0 <23 || >=24.0.0 <25"
  },
  "main": "./dist/esm/main.js",
  "bin": {
    "noeos-ve": "./dist/esm/main.js"
  },
  "types": "./dist/types/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/main.d.ts",
      "import": "./dist/esm/main.js"
    }
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "dependencies": {
    "@noeos/verification-engine": "1.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeos/verification-engine.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/noeos/verification-engine/issues"
  },
  "homepage": "https://github.com/noeos/verification-engine/blob/main/docs/03-contratos/03-cli.md",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
