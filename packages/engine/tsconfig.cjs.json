{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "ignoreDeprecations": "5.0",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "noEmit": false,
    "outDir": "dist/cjs",
    "sourceMap": false,
    "verbatimModuleSyntax": false
  }
}
